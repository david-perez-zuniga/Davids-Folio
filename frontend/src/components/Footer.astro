---
const links = [
	{ label: 'GitHub', href: 'https://github.com/david-perez-zuniga' },
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/humberto-zuniga-b42140386?utm_source=share_via&utm_content=profile&utm_medium=member_android',
	},
	{ label: 'Correo', href: 'mailto:davidhumbertop503@gmail.com' },
];
---

<footer class="w-full py-20 bg-surface-container-lowest border-t border-outline-variant/20">
	<div class="flex flex-col md:flex-row justify-between items-center max-w-container-max mx-auto px-gutter py-8">
		<div class="font-label-md text-label-md font-semibold text-primary mb-4 md:mb-0">DHPZ</div>
		<p class="font-body-md text-body-md text-on-surface-variant mb-6 md:mb-0 text-center">
			© 2026 David Humberto Perez Zuniga. Todos los derechos reservados.
		</p>
		<div class="flex gap-6 opacity-80 hover:opacity-100 transition-opacity">
			{
				links.map((link) => (
					<a
						class="text-on-surface-variant hover:text-primary transition-colors font-label-md text-label-md"
						href={link.href}
						{...(link.href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {})}
					>
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</footer>
